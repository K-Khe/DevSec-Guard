# Copy to .env.local and fill in. Never commit .env.local.

# --- AI provider (optional — falls back to 100% Local Remediation Engine automatically if omitted) ---
AI_PROVIDER=gemini
AI_API_KEY=your-key-here
# Optional. Defaults: gemini-flash-lite-latest (gemini) / gpt-4o-mini (openai)
AI_MODEL=

# --- Rate limits (optional, requests per minute) ---
RATE_LIMIT_SCAN_PER_MIN=10
RATE_LIMIT_ANALYZE_PER_MIN=5
RATE_LIMIT_ANALYZE_GLOBAL_PER_MIN=30

# --- Shared production rate limit (Upstash Redis REST; both values required) ---
# Keep these values server-side. Use a random RATE_LIMIT_KEY_SALT so Redis keys
# and audit logs cannot be correlated back to raw client IPs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_KEY_SALT=
RATE_LIMIT_NAMESPACE=devsec-guard

# --- Audit logging & Authorization / Usage Policy (optional) ---
AUDIT_LOG_ENABLED=true
# Set to true only for a restricted/internal deployment that requires each caller to attest ownership.
# Public passive scans remain protected by SSRF, private-network and restricted-domain controls.
REQUIRE_SCAN_ATTESTATION=false
# Optional API token required via x-scanner-token or Authorization: Bearer <token>
SCANNER_ACCESS_TOKEN=
# Optional comma-separated allowlist (e.g. example.com,*.mycompany.com)
SCAN_ALLOWED_HOSTS=
# Optional comma-separated extra blocked suffixes/hosts (.gov and .mil are always blocked)
SCAN_BLOCKED_HOSTS=
