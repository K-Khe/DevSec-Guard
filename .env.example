# Copy to .env.local and fill in. Never commit .env.local.

# --- AI provider (required for the AI Remediation card) ---
AI_PROVIDER=gemini
AI_API_KEY=your-key-here
# Optional. Defaults: gemini-flash-lite-latest (gemini) / gpt-4o-mini (openai)
AI_MODEL=

# --- Rate limits (optional, requests per minute) ---
RATE_LIMIT_SCAN_PER_MIN=10
RATE_LIMIT_ANALYZE_PER_MIN=5
RATE_LIMIT_ANALYZE_GLOBAL_PER_MIN=30

